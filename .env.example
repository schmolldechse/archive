# Public application URLs
PUBLIC_API_BASE_URL=http://localhost:5200
ARCHIVE_PUBLIC_BASE_URL=http://localhost:5200
SnapshotContent__PublicOrigin=http://127.0.0.1:5200

# Google sign-in configuration. Export these variables for a direct API start,
# or configure appsettings.Development.json; dotnet does not load .env itself.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__FrontendOrigin=http://localhost:5173
Authentication__PublicApiOrigin=http://localhost:5200

# PostgreSQL credentials for local development. Replace the secret value.
POSTGRES_DATABASE=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# API and worker share processing retention; direct dotnet runs do not load .env.
Processing__TerminalRetentionSeconds=60
Processing__CleanupIntervalSeconds=30
Processing__CleanupBatchSize=100

# S3-compatible object storage used during local development.
OBJECT_STORAGE_SERVICE_URL=http://localhost:9000
OBJECT_STORAGE_INTERNAL_SERVICE_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-strong-local-secret
OBJECT_STORAGE_BUCKET=snapshots

# Use Production for both values on a deployed server.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Docker Compose runs headed Chromium inside a virtual display. Direct local
# worker runs use the value from appsettings.Development.json.
ARCHIVE_BROWSER_HEADLESS=false
ARCHIVE_BROWSER_USER_AGENT=ArchiveBot/1.0
ARCHIVE_CHALLENGE_TIMEOUT_SECONDS=45
ARCHIVE_CHALLENGE_RELOAD_ATTEMPTS=1
