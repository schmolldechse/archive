{
  "Logging": {
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "Bucket": "snapshots"
  },
  "Archive": {
    "Browser": {
      "Headless": true,
      "UserAgent": "ArchiveBot/1.0",
      "ChallengeTimeoutSeconds": 45,
      "ChallengeReloadAttempts": 1
    },
    "MaxDurationSeconds": 120,
    "MaxStorageBytes": 250000000,
    "MaxResources": 500,
    "MaxScrollRounds": 24,
    "QuietPeriodMilliseconds": 1000
  },
  "Processing": {
    "TerminalRetentionSeconds": 60
  }
}
