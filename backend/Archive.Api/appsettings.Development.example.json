{
  "Authentication": {
    "PublicApiOrigin": "http://localhost:5200",
    "FrontendOrigin": "http://localhost:5173",
    "Google": {
      "ClientId": "replace-with-your-google-client-id",
      "ClientSecret": "replace-with-your-google-client-secret"
    }
  },
  "Replay": {
    "PublicOrigin": "http://127.0.0.1:5200"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=archive;Username=archive;Password=replace-with-your-local-password"
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "replace-with-your-local-access-key",
    "SecretKey": "replace-with-your-local-secret-key",
    "Bucket": "snapshots"
  },
  "Database": {
    "Initialize": true
  },
  "Processing": {
    "TerminalRetentionSeconds": 60,
    "CleanupIntervalSeconds": 30,
    "CleanupBatchSize": 100
  }
}
