  },
  "Archive": {
    "MaxUploadBytes": 250000000,
    "MaxDurationSeconds": 120,
    "MaxStorageBytes": 250000000,
    "MaxResources": 500,
    "MaxScrollRounds": 24,
    "QuietPeriodMilliseconds": 1000
  },
  "Processing": {
    "TerminalRetentionSeconds": 60,
    "CleanupIntervalSeconds": 30,
    "CleanupBatchSize": 100
  }
}
