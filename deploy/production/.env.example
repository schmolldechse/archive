# Copy to .env and keep the copy out of Git.
POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=

OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=snapshots

# Browser-visible HTTPS origins; the reverse proxy routes to the internal
# frontend and API ports.
ORIGIN=https://archive.example.com
PUBLIC_API_BASE_URL=https://api.archive.example.com
ARCHIVE_PUBLIC_BASE_URL=https://api.archive.example.com

# Register PUBLIC_API_BASE_URL/api/auth/callback/google as the Google redirect URI.
AUTHENTICATION_GOOGLE_CLIENT_ID=
AUTHENTICATION_GOOGLE_CLIENT_SECRET=
AUTHENTICATION_SESSION_COOKIE_DOMAIN=

ARCHIVE_BROWSER_HEADLESS=true
ARCHIVE_BROWSER_USER_AGENT=VoldechseArchiveBot/1.0 (+https://archive.voldechse.wtf/)
ARCHIVE_CRAWL_POLICY_ENABLED=true
ARCHIVE_CRAWL_USER_AGENT_TOKEN=VoldechseArchiveBot
ARCHIVE_MINIMUM_HOST_DELAY_SECONDS=2

ARCHIVE_WEB_BOT_AUTH_ENABLED=false
ARCHIVE_WEB_BOT_AUTH_SIGNATURE_AGENT=https://archive.voldechse.wtf
ARCHIVE_WEB_BOT_AUTH_KEY_DIRECTORY=../../.secrets
