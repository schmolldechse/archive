# Public API origin, reachable by the browser. SvelteKit reads this at runtime
# through $env/dynamic/public and exposes PUBLIC_ variables to the client.
PUBLIC_API_BASE_URL=http://localhost:5200

# Optional server-only address ($env/dynamic/private), e.g. http://api:8080
# in Docker. Leave unset locally to reuse PUBLIC_API_BASE_URL.
# INTERNAL_API_BASE_URL=http://api:8080
